# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Connection
DATABASE_URL="postgresql://postgres:postgres@db:5432/devflow?schema=public"

# Database Connection for local non-docker testing
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devflow?schema=public"

# JWT Auth Secrets
JWT_ACCESS_SECRET="devflow_jwt_access_secret_super_secure_key_2026"
JWT_REFRESH_SECRET="devflow_jwt_refresh_secret_super_secure_key_2026"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# OpenAI API Key (optional for testing fallback)
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"
